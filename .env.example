# Copy this file to .env before running `docker compose up`.

# The password for a fresh install. It is only read while no password exists
# yet; after that, change it from Settings in the app. Leave it empty to choose
# a password in the browser the first time you open Perennial instead.
INITIAL_PASSWORD=

# Where, inside the container, the daily backups are written. Leave it empty
# for /data/backups, next to the database. To keep them on another disk, mount
# that disk in docker-compose.yml and name the mount point here.
BACKUP_DIR=

# The port Perennial is served on.
PORT=3000
